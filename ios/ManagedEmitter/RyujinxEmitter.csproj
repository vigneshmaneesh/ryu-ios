<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishAot Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">true</PublishAot>
    <PublishAotUsingRuntimePack Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">true</PublishAotUsingRuntimePack>
    <NativeLib>Shared</NativeLib>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Actual upstream AArch64 decoder, compiler, register allocator and context. -->
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/CodeWriter.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/AddressForm.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/CompiledFunction.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/CpuPreset.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/CpuPresets.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/IsaFeature.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/IsaVersion.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/NativeContextOffsets.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/State/NativeContext.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/CodeGen/**/*.cs" Exclude="../../src/Ryujinx.Cpu/LightningJit/CodeGen/Arm64/StackWalker.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/Arm64/**/*.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/Graph/*.cs" />
    <Compile Include="../../src/Ryujinx.Cpu/LightningJit/Table/*.cs" />
    <Compile Include="../../src/ARMeilleure/Memory/IMemoryManager.cs" />
    <Compile Include="../../src/ARMeilleure/Memory/MemoryManagerType.cs" />
    <Compile Include="../../src/ARMeilleure/Memory/IJitMemoryAllocator.cs" />
    <Compile Include="../../src/ARMeilleure/Memory/IJitMemoryBlock.cs" />
    <Compile Include="../../src/ARMeilleure/Common/IAddressTable.cs" />
    <Compile Include="../../src/ARMeilleure/Common/AddressTableType.cs" />
    <Compile Include="../../src/ARMeilleure/Common/AddressTableLevel.cs" />
    <Compile Include="../../src/ARMeilleure/State/V128.cs" />
  </ItemGroup>
</Project>
